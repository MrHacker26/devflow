{
  "name": "devflow",
  "private": true,
  "scripts": {
    "clean": "rimraf node_modules **/*/node_modules **/*/dist **/*/.turbo",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "match-versions": "bun run scripts/match-versions.ts",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\" --cache",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\" --cache"
  },
  "devDependencies": {
    "@types/node": "^20",
    "prettier": "3.9.4",
    "prettier-plugin-tailwindcss": "0.8.0",
    "rimraf": "^6.1.3",
    "turbo": "2.10.3",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@clack/prompts": "1.7.0"
  }
}
